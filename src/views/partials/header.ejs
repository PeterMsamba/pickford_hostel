<header>
    <h1>Hostel Manager</h1>
    <% if (typeof user !== 'undefined' && user) { %>
        <nav>
            <% if (user.role_name === 'landlord') { %>
                <a href="/landlord/dashboard">Dashboard</a> | 
                <a href="/landlord/residents">Residents</a> | 
                <a href="/landlord/payments">Payments</a> | 
            <% } else { %>
                <a href="/resident/dashboard">Dashboard</a> | 
            <% } %>
            <a href="/logout">Logout</a>
        </nav>
    <% } %>
</header>
<hr>