<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Hostel Management System' %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <nav class="navbar">
            <a href="/" class="brand">Pickford Hostel</a>

            <% if (typeof user !== 'undefined' && user) { %>
                <ul class="nav-links">
                    <% if (user.role_name === 'landlord') { %>
                        <li><a href="/landlord/dashboard">Dashboard</a></li>
                        <li><a href="/landlord/residents">Residents</a></li>
                        <li><a href="/landlord/payment-status">Payment Status</a></li>
                        <li><a href="/landlord/payments">Payment Logs</a></li>
                    <% } else if (user.role_name === 'resident') { %>
                        <li><a href="/resident/dashboard">Dashboard</a></li>
                        <li><a href="/rooms">Book Room</a></li>
                        <li><a href="/resident/payment-history">Payment History</a></li>
                    <% } %>
                    <li><a href="/logout" class="logout-btn">Logout</a></li>
                </ul>
            <% } else { %>
                <!-- Only render the Login link if the current page is NOT the login page -->
                <% if (typeof title === 'undefined' || !title.toLowerCase().includes('login')) { %>
                    <ul class="nav-links">
                        <li><a href="/login">Login</a></li>
                    </ul>
                <% } %>
            <% } %>
        </nav>
    </header>