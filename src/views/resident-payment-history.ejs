<%- include('partials/header', { title: 'Resident - Payment History' }) %>

<main class="container">
    <h2>My Payment History</h2>

    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Billing Period</th>
                    <th>Room</th>
                    <th>Amount</th>
                    <th>Transaction Ref</th>
                    <th>Status</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                <% if (!locals.payments || payments.length === 0) { %>
                    <tr><td colspan="6" style="text-align: center;">No payment records found.</td></tr>
                <% } else { %>
                    <% payments.forEach(p => { %>
                        <tr>
                            <td><%= p.payment_month %>/<%= p.payment_year %></td>
                            <td><%= p.room_number %></td>
                            <td>MWK <%= Number(p.amount || 0).toLocaleString() %></td>
                            <td><code><%= p.tx_ref %></code></td>
                            <td>
                                <strong style="color: <%= p.status === 'successful' ? 'var(--success, green)' : 'var(--danger, red)' %>;">
                                    <%= p.status ? p.status.toUpperCase() : 'UNKNOWN' %>
                                </strong>
                            </td>
                            <td><%= new Date(p.created_at).toLocaleString() %></td>
                        </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>
</main>

<%- include('partials/footer') %>