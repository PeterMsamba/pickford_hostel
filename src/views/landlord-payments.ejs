<%- include('partials/header', { title: 'Payment Audit - Hostel Manager' }) %>

<main class="container">
    <h2>Monthly Rent Audit Trail</h2>

    <form method="GET" action="/landlord/payments" style="margin-bottom: 20px;">
        <label for="month">Month:</label>
        <select name="month" id="month">
            <% for(let m = 1; m <= 12; m++) { %>
                <!-- Used loose equality (==) to handle string vs number types from query params -->
                <option value="<%= m %>" <%= (typeof selectedMonth !== 'undefined' && m == selectedMonth) ? 'selected' : '' %>>
                    Month <%= m %>
                </option>
            <% } %>
        </select>

        <label for="year">Year:</label>
        <input type="number" name="year" id="year" value="<%= typeof selectedYear !== 'undefined' ? selectedYear : new Date().getFullYear() %>" style="width: 80px;">

        <button type="submit">Filter Transactions</button>
    </form>

    <div class="table-wrapper">
    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Resident</th>
                <th>Room</th>
                <th>Amount (MWK)</th>
                <th>Transaction Ref</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <% payments.forEach(payment => { %>
                <tr>
                    <td><%= new Date(payment.created_at).toLocaleDateString() %></td>
                    <td><%= payment.resident_name %></td>
                    <td><%= payment.room_number %></td>
                    <td>MWK <%= payment.amount %></td>
                    <td><code><%= payment.tx_ref %></code></td>
                    <td><%= payment.status %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</div>
</main>

<%- include('partials/footer') %>