<%- include('partials/header', { title: 'Landlord - Payment Status Report' }) %>

<main class="container">
    <h2>Monthly Payment Breakdown</h2>

    <form method="GET" action="/landlord/payment-status">
        <label for="month">Month:</label>
        <input type="number" id="month" name="month" min="1" max="12" value="<%= selectedMonth %>">
        
        <label for="year">Year:</label>
        <input type="number" id="year" name="year" value="<%= selectedYear %>">
        
        <button type="submit">Filter</button>
    </form>

    <section class="card">
        <h3>Paid Residents (<%= paidResidents.length %>)</h3>
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Resident Name</th>
                        <th>Room</th>
                        <th>Amount Paid</th>
                        <th>Tx Ref</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (paidResidents.length === 0) { %>
                        <tr><td colspan="5" style="text-align: center;">No paid records found for this period.</td></tr>
                    <% } else { %>
                        <% paidResidents.forEach(r => { %>
                            <tr style="background-color: var(--success-bg, #dcfce7);">
                                <td><%= r.resident_name %></td>
                                <td><%= r.room_number %></td>
                                <td>MWK <%= Number(r.monthly_rate || 0).toLocaleString() %></td>
                                <td><code><%= r.tx_ref %></code></td>
                                <td><%= new Date(r.payment_date).toLocaleDateString() %></td>
                            </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </section>

    <section class="card">
        <h3>Unpaid Residents (<%= unpaidResidents.length %>)</h3>
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Resident Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Room</th>
                        <th>Due Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (unpaidResidents.length === 0) { %>
                        <tr><td colspan="5" style="text-align: center;">All residents have paid for this month!</td></tr>
                    <% } else { %>
                        <% unpaidResidents.forEach(r => { %>
                            <tr style="background-color: var(--danger-bg, #fee2e2);">
                                <td><%= r.resident_name %></td>
                                <td><%= r.resident_email %></td>
                                <td><%= r.resident_phone || 'N/A' %></td>
                                <td><%= r.room_number %></td>
                                <td>MWK <%= Number(r.monthly_rate || 0).toLocaleString() %></td>
                            </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </section>
</main>

<%- include('partials/footer') %>